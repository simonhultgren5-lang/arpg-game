{
  "name": "depths-of-darkness",
  "productName": "Depths of Darkness",
  "description": "Dark fantasy top-down dungeon crawler",
  "author": "afiniel",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "main": "electron/main.cjs",
  "desktop": {
    "githubRepo": "simonhultgren5-lang/arpg-game",
    "minLauncherVersion": "0.1.1"
  },
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "bump:patch": "npm version patch --no-git-tag-version && node scripts/sync-version.mjs",
    "bump:minor": "npm version minor --no-git-tag-version && node scripts/sync-version.mjs",
    "bump:major": "npm version major --no-git-tag-version && node scripts/sync-version.mjs",
    "game": "node scripts/sync-version.mjs && node scripts/patch-notes.mjs && electron .",
    "game:offline": "node scripts/sync-version.mjs && node scripts/patch-notes.mjs && electron . --offline",
    "dist": "node scripts/sync-version.mjs && node scripts/patch-notes.mjs && electron-builder --win",
    "dist:dir": "node scripts/sync-version.mjs && node scripts/patch-notes.mjs && electron-builder --win --dir",
    "release": "node scripts/release.mjs",
    "release:launcher": "node scripts/release.mjs --launcher",
    "dev": "node scripts/sync-version.mjs && tsx server.ts",
    "start": "node server.ts",
    "build": "node scripts/sync-version.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "server": "node --no-warnings game-server/server.mjs",
    "server:pack": "node scripts/pack-server.mjs",
    "server:image": "node scripts/pack-server.mjs --image",
    "patch-notes": "node scripts/patch-notes.mjs",
    "icons": "electron scripts/build-icons.cjs"
  },
  "build": {
    "appId": "com.afiniel.depthsofdarkness",
    "productName": "Depths of Darkness",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "game/**/*",
      "launcher/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "icon": "launcher/assets/icon.ico",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Depths of Darkness",
      "artifactName": "Depths-of-Darkness-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Depths-of-Darkness-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^39",
    "electron-builder": "^26",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller"
  ]
}
