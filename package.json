{
  "name": "depths-of-darkness",
  "productName": "Depths of Darkness",
  "description": "Dark fantasy action RPG",
  "author": "afiniel",
  "private": true,
  "version": "0.5.0-beta.7",
  "type": "module",
  "main": "electron/main.cjs",
  "desktop": {
    "githubRepo": "simonhultgren5-lang/arpg-game"
  },
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "bump:patch": "npm version patch --no-git-tag-version && node scripts/sync-version.mjs",
    "bump:minor": "npm version minor --no-git-tag-version && node scripts/sync-version.mjs",
    "bump:major": "npm version major --no-git-tag-version && node scripts/sync-version.mjs",
    "bump:beta": "npm version prerelease --preid beta --no-git-tag-version && node scripts/sync-version.mjs",
    "bump:dev": "npm version prerelease --preid dev --no-git-tag-version && node scripts/sync-version.mjs",
    "launcher": "node scripts/sync-version.mjs && node scripts/patch-notes.mjs && electron .",
    "game": "bun run launcher",
    "dist": "node scripts/sync-version.mjs && node scripts/patch-notes.mjs && node scripts/export-godot.mjs && electron-builder --win",
    "dist:dir": "node scripts/sync-version.mjs && node scripts/patch-notes.mjs && node scripts/export-godot.mjs && electron-builder --win --dir",
    "release": "node scripts/release.mjs",
    "release:launcher": "node scripts/release.mjs",
    "clean": "rm -rf release godot/build",
    "server": "node --no-warnings game-server/server.mjs",
    "server:pack": "node scripts/pack-server.mjs",
    "server:image": "node scripts/pack-server.mjs --image",
    "patch-notes": "node scripts/patch-notes.mjs",
    "godot:export": "node scripts/export-godot.mjs",
    "assets:build": "node scripts/assets/build.mjs",
    "audio:act1": "node scripts/audio/act1-audio.mjs",
    "audio:hollowmere": "node scripts/audio/hollowmere-bank.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:reset": "node scripts/dev-reset.mjs",
    "test": "node scripts/test.mjs",
    "test:quick": "node scripts/test.mjs --quick",
    "admin": "node --no-warnings game-server/admin.mjs",
    "ci:compile": "node scripts/ci/compile.mjs",
    "ci:qa": "node scripts/ci/qa.mjs",
    "icons": "electron scripts/build-icons.cjs"
  },
  "build": {
    "appId": "com.afiniel.depthsofdarkness",
    "productName": "Depths of Darkness",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "launcher/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "godot/build/DepthsOfDarkness.exe",
        "to": "game/DepthsOfDarkness.exe"
      }
    ],
    "npmRebuild": false,
    "icon": "launcher/assets/icon.ico",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Depths of Darkness",
      "artifactName": "Depths-of-Darkness-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Depths-of-Darkness-${version}-portable.${ext}"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^39",
    "electron-builder": "^26"
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller"
  ]
}
