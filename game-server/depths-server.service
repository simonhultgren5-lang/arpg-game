# systemd service: starts the Depths of Darkness server when the Raspberry Pi boots
# and restarts it if it crashes. Install steps are in game-server/README.md.
#
# Change USERNAME below to your Pi login name (run `whoami` on the Pi to see it).

[Unit]
Description=Depths of Darkness game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=USERNAME
WorkingDirectory=/home/USERNAME/depths-server
ExecStart=/usr/bin/node --no-warnings /home/USERNAME/depths-server/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
