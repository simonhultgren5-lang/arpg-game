; Engine configuration file.
; Depths of Darkness — Godot 4 (3D) version. See README.md.

config_version=5

[application]

config/name="Depths of Darkness"
config/description="A grim gothic action RPG. Act I: The Tolling of Hollowmere."
config/version="0.4.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.047, 0.039, 0.071, 1)
boot_splash/show_image=true
boot_splash/image="res://art/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://icon.svg"
; Write each log line to the log file right away, so a crash report has the end of the log.
run/flush_stdout_on_print=true

[autoload]

ActAudio="*res://scripts/autoload/act_audio.gd"
Boot="*res://scripts/autoload/boot.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Game="*res://scripts/autoload/game_state.gd"
Dev="*res://scripts/autoload/dev_console.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="DEFAULT"

[rendering]

environment/defaults/default_clear_color=Color(0.047, 0.039, 0.071, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/atlas_size=2048
