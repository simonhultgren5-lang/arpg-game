# Scripts and files that run on the Raspberry Pi must keep Linux line endings
*.sh text eol=lf
game-server/** text eol=lf

# Godot writes its project files with LF line endings. Checking them out the same way keeps
# exports and imports from showing every .import file as changed on Windows.
godot/** text=auto eol=lf

# ---------------------------------------------------------------- Git LFS: large binary assets
# Stored in Git LFS so the repo stays fast to clone (see source-assets/README.md). These come after
# the rules above so binaries are never treated as text.
# Images
*.png filter=lfs diff=lfs merge=lfs -text
# glTF model buffers (the .gltf next to them is JSON and stays plain text, so it diffs).
godot/assets/**/*.bin filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
# Audio
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
# Video and cinematics
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.ogv filter=lfs diff=lfs merge=lfs -text
# Models and animations (game-ready exports)
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
# Fonts
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.woff filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text

# Editable source files: lockable, like a Perforce checkout. They arrive read-only;
# `git lfs lock <file>` before editing, `git lfs unlock <file>` after pushing.
*.psd filter=lfs diff=lfs merge=lfs -text lockable
*.kra filter=lfs diff=lfs merge=lfs -text lockable
*.spp filter=lfs diff=lfs merge=lfs -text lockable
*.sbsar filter=lfs diff=lfs merge=lfs -text lockable
*.blend filter=lfs diff=lfs merge=lfs -text lockable
*.ma filter=lfs diff=lfs merge=lfs -text lockable
*.mb filter=lfs diff=lfs merge=lfs -text lockable
*.max filter=lfs diff=lfs merge=lfs -text lockable
*.ztl filter=lfs diff=lfs merge=lfs -text lockable
*.prproj filter=lfs diff=lfs merge=lfs -text lockable
source-assets/** filter=lfs diff=lfs merge=lfs -text lockable
source-assets/**/README.md !filter !diff !merge text !lockable
